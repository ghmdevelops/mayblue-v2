# Copie para .env e preencha. O .env esta no .gitignore -- nunca comite segredos.

# Shopee Affiliate Open API
# Onde obter: affiliate.shopee.com.br > faca login > secao "Open API"
# > gerar/visualizar App ID e App Secret (Chave de API)
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# Mercado Livre (opcional, so serve para o probe do comando `doctor`).
# O ML nao tem API de afiliados; nao ha token que habilite curadoria automatica.
ML_ACCESS_TOKEN=

# Firebase Realtime Database (opcional -- so se [firebase].habilitado = true).
#
# A URL NAO e a mesma coisa que o projectId. O Realtime Database e um produto
# separado: crie em console.firebase.google.com > Realtime Database e copie a
# URL que aparece no topo.
FIREBASE_DATABASE_URL=https://SEU-PROJETO-default-rtdb.firebaseio.com

# Opcao 1 (recomendada): conta de servico via Firebase Auth email/senha.
# Habilite Authentication > Sign-in method > Email/Senha, crie um usuario
# so para o robo e restrinja as regras ao uid dele.
# A apiKey e a mesma do seu app web -- ela e publica por design, nao e segredo.
FIREBASE_API_KEY=
FIREBASE_EMAIL=
FIREBASE_SENHA=

# Opcao 2 (legado): database secret. Da acesso TOTAL ao banco. Use so se a
# opcao 1 nao for viavel. Console > Configuracoes > Contas de servico >
# Segredos do banco de dados.
FIREBASE_DB_SECRET=

# Telegram (opcional -- so se [telegram].habilitado = true).
# Token: fale com @BotFather no Telegram, /newbot, copie o token.
# Chat id: mande qualquer mensagem para o bot e veja o id em
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Rede corporativa com inspecao TLS (opcional).
# FLOW02_CA_BUNDLE: caminho de um .pem com a CA da empresa, se o Python nao
#   encontrar a cadeia sozinho.
# FLOW02_TLS_STRICT: 1 reativa o ssl.VERIFY_X509_STRICT que o Python 3.13+
#   liga por padrao. Fica desligado porque certificados de proxy corporativo
#   costumam falhar nessa checagem estrita. A validacao de cadeia, validade e
#   hostname continua ativa em qualquer caso.
FLOW02_CA_BUNDLE=
FLOW02_TLS_STRICT=0
